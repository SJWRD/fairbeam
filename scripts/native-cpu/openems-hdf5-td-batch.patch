diff --git a/tools/hdf5_file_writer.cpp b/tools/hdf5_file_writer.cpp
index 856c80e..79c77d0 100644
--- a/tools/hdf5_file_writer.cpp
+++ b/tools/hdf5_file_writer.cpp
@@ -529,3 +529,26 @@ bool HDF5_File_Writer::WriteAttribute(std::string locName, std::string attr_name
 {
 	return HDF5_File_Writer::WriteAttribute(locName, attr_name, &value, 0, H5T_NATIVE_HBOOL);
 }
+
+// Experimental non-legacy TD output: preserve dataset bytes and rank-1 time attribute,
+// while sharing a file handle for a single complete sample. No handle crosses samples.
+bool HDF5_File_Writer::WriteTimeDomainVectorField(std::string dataSetName, ArrayLib::ArrayNIJK<float>& data, float time)
+{
+    hid_t file = H5Fopen(m_filename.c_str(), H5F_ACC_RDWR, H5P_DEFAULT);
+    if (file < 0) return false;
+    hid_t group = OpenGroup(file, m_Group);
+    if (group < 0) { H5Fclose(file); return false; }
+    size_t dims[4] = {data.extent(0), data.extent(1), data.extent(2), data.extent(3)};
+    bool ok = WriteData(group, dataSetName, H5T_NATIVE_FLOAT, data.data(), 4, dims, "NXYZ");
+    if (ok) {
+        hid_t dataset = H5Dopen(group, dataSetName.c_str(), H5P_DEFAULT);
+        if (dataset < 0) ok = false;
+        else {
+            ok = WriteAttribute(dataset, "time", &time, 1, H5T_NATIVE_FLOAT);
+            if (H5Dclose(dataset) < 0) ok = false;
+        }
+    }
+    if (H5Gclose(group) < 0) ok = false;
+    if (H5Fclose(file) < 0) ok = false;
+    return ok;
+}
